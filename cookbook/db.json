      "title": "Chicken Tikka Masala",
      "description": "Creamy and flavorful Indian curry with tender chicken pieces",
      "cuisine": "Indian",
      "prepTime": 30,
      "cookTime": 45,
      "servings": 4,
      "difficulty": "Medium",
      "ingredients": [
        "1.5 lbs boneless chicken, cut into cubes",
        "1 cup plain yogurt",
        "2 tbsp lemon juice",
        "2 tsp ground cumin",
        "2 tsp paprika",
        "2 tsp garam masala",
        "1 tsp turmeric",
        "1 large onion, chopped",
        "3 cloves garlic, minced",
        "1 tbsp ginger, grated",
        "1 can (14 oz) tomato sauce",
        "1 cup heavy cream",
        "2 tbsp butter",
        "Salt to taste",
        "Fresh cilantro for garnish"
      ],
      "instructions": [
        "Marinate chicken in yogurt, lemon juice, and spices for at least 1 hour",
        "Heat butter in a large skillet over medium heat",
        "Cook chicken until browned, about 5-7 minutes",
        "Remove chicken and set aside",
        "In the same pan, sauté onions until golden",
        "Add garlic and ginger, cook for 1 minute",
        "Add tomato sauce and simmer for 10 minutes",
        "Return chicken to pan and cook for 10 more minutes",
        "Stir in heavy cream and simmer for 5 minutes",
        "Garnish with cilantro and serve with rice or naan"
      ],
